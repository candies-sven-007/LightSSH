{
  "name": "lightssh",
  "productName": "LightSSH",
  "version": "1.2.0",
  "description": "A clean SSH client (中文 / English)",
  "main": "main.js",
  "author": "Candies Sven",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-packager . LightSSH --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=build_icon.ico --ignore=^/dist --ignore=^/docs --ignore=^/\\.github --ignore=^/README"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.4.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/candies-sven-007/LightSSH"
  }
}
